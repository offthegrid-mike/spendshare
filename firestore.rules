// Manual two-account verification checklist (run against emulator with two test users):
//   1. Member can read/write own group:
//      - Sign in as userA, create a group → expect success (201)
//      - Read that group as userA → expect success (200)
//      - Write an expense inside that group as userA → expect success
//   2. Non-member is denied read access to a group:
//      - Sign in as userB (not in the group's members array)
//      - Attempt to read that group document → expect PERMISSION_DENIED (403)
//      - Attempt to write an expense inside that group as userB → expect PERMISSION_DENIED

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only allowlisted people may use the app: a verified email with a document
    // at allowlist/{email}. Entries are managed in the Firebase console, so no
    // email lives in this public repo. Every rule below goes through signedIn().
    function onAllowlist() {
      return request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email.lower()));
    }
    function signedIn() { return request.auth != null && onAllowlist(); }
    function myEmail() { return request.auth.token.email.lower(); }
    function emailVerified() { return signedIn() && request.auth.token.email_verified == true; }
    // The accepting/invitee principal: signed-in, verified, and matching the invite email.
    function isInvitee() { return emailVerified() && resource != null && resource.data.email == myEmail(); }
    function isMember(groupId) {
      return signedIn()
        && (request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members);
    }
    function isOwner(groupId) {
      return signedIn()
        && get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid;
    }

    // Anyone signed in may check their own entry, so the app can explain why
    // it turned them away. Nobody can list or change the allowlist from the app.
    match /allowlist/{email} {
      allow get: if request.auth != null && request.auth.token.email.lower() == email;
      allow list, write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    // Work tracker. Rules do not inherit from users/{uid}, so the subcollections
    // need their own blocks. A Work day is a tax record: it is never deleted and
    // every save appends exactly one revision (the app writes it with arrayUnion).
    function validWorkDay(d, day) {
      return d.date == day
        && (d.type == null || d.type in ['home', 'office', 'leave'])
        && (!('minutes' in d) || (d.minutes is int && d.minutes >= 1 && d.minutes <= 1440))
        && d.addedLater is bool && d.countedInClaim is bool && d.finishConfirmed is bool
        // size() also works on a string or a map, so the history must be a real list.
        && d.revisions is list;
    }

    match /users/{uid}/workDays/{day} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && validWorkDay(request.resource.data, day)
        && request.resource.data.revisions.size() == 1;
      allow update: if signedIn() && request.auth.uid == uid
        && validWorkDay(request.resource.data, day)
        && request.resource.data.revisions.size() == resource.data.revisions.size() + 1
        && request.resource.data.revisions[0:resource.data.revisions.size()] == resource.data.revisions;
      allow delete: if false;
    }

    match /users/{uid}/workSettings/{doc} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && doc == 'main'
        && (!('workWeekdays' in request.resource.data)
            || request.resource.data.workWeekdays.hasOnly([1, 2, 3, 4, 5, 6, 7]))
        && (!('defaultMinutes' in request.resource.data)
            || (request.resource.data.defaultMinutes is int
                && request.resource.data.defaultMinutes >= 1 && request.resource.data.defaultMinutes <= 1440))
        // Rules cannot iterate a map's values, so the client validates each rate
        // (a finite number, 0 or more); this only keeps the field a map.
        && (!('ratesCentsPerHour' in request.resource.data)
            || request.resource.data.ratesCentsPerHour is map)
        // A malformed start date can make the app's missing-days scan throw.
        && (!('trackingStartDate' in request.resource.data)
            || request.resource.data.trackingStartDate == null
            || (request.resource.data.trackingStartDate is string
                && request.resource.data.trackingStartDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')));
      allow delete: if false;
    }

    // A trip is a group with kind 'trip' and its first and last days ('YYYY-MM-DD').
    // A household has neither field. kind is set at create and is in no update's
    // list of editable keys, so a group never changes between household and trip.
    function isIsoDate(s) { return s is string && s.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'); }
    function validTrip(t) {
      return t is map && t.keys().hasOnly(['startDate', 'endDate'])
        && isIsoDate(t.get('startDate', null)) && isIsoDate(t.get('endDate', null))
        && t.endDate >= t.startDate;
    }
    function validKind(d) {
      return ('kind' in d) ? (d.kind == 'trip' && ('trip' in d) && validTrip(d.trip)) : !('trip' in d);
    }

    // A closed trip (tripClosedAt set, owner only) can't change: no expenses, items,
    // cash, top-ups or hand-overs are written or deleted. Settle-up still works.
    function tripOpen(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data.get('tripClosedAt', null) == null;
    }

    function tripCurrencyChanged() {
      return resource.data.get('kind', null) == 'trip'
        && request.resource.data.currency != resource.data.currency;
    }

    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.members
        && request.resource.data.memberUids.hasOnly([request.auth.uid])
        && validKind(request.resource.data);
      // Members can only edit non-privileged fields. A trip's currency is its home
      // currency, which every balance is worked out in, so nobody changes it.
      allow update: if isMember(groupId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'currency'])
          && !tripCurrencyChanged()
        // Owners can edit any group-level field (name, currency, ownerUid, members, memberUids),
        // and a trip's dates
        || ( isOwner(groupId)
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['name', 'currency', 'ownerUid', 'members', 'memberUids', 'trip', 'tripClosedAt'])
             && validKind(request.resource.data)
             && (!('tripClosedAt' in request.resource.data)
                 || (request.resource.data.get('kind', null) == 'trip' && request.resource.data.tripClosedAt is timestamp))
             && !tripCurrencyChanged() )
        // Invite acceptance: a verified user with a pending invite can add ONLY themselves
        // to members/memberUids. The join must be strictly additive (existing members/memberUids
        // preserved) AND the single added principal must be the accepting user.
        || ( signedIn()
             && request.auth.token.email_verified == true
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberUids'])
             && !(request.auth.uid in resource.data.members)
             && request.auth.uid in request.resource.data.members
             && get(/databases/$(database)/documents/groups/$(groupId)/invites/$(myEmail())).data.status == 'pending'
             // memberUids: strictly additive and the single new element is the caller
             && request.resource.data.memberUids.toSet().hasAll(resource.data.memberUids)
             && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
             && request.auth.uid in request.resource.data.memberUids
             && request.resource.data.memberUids.toSet()
                  .difference(resource.data.memberUids.toSet()) == [request.auth.uid].toSet()
             // members map: the caller's entry is the only one added, removed or changed —
             // existing members' entries (name, email, role, joinedAt) must be untouched
             && request.resource.data.members.diff(resource.data.members).affectedKeys()
                  .hasOnly([request.auth.uid])
             // pin the new member's role to 'member'
             && request.resource.data.members[request.auth.uid].role == 'member' );
      allow delete: if isOwner(groupId);

      match /invites/{inviteId} {
        allow create: if isMember(groupId);
        // Members manage invites freely. An invitee (verified, email-matching) may
        // read their invite and transition it ONLY into a terminal state — never back
        // to 'pending' (which would defeat owner revocation; see M-1).
        allow read: if isMember(groupId) || isInvitee();
        allow update: if isMember(groupId)
          || (isInvitee() && request.resource.data.status != 'pending');
        allow delete: if isMember(groupId);
      }
      match /categories/{categoryId} {
        allow read, delete: if isMember(groupId);
        // A budget is whole cents a month, zero or more; a category with none omits the field.
        allow create, update: if isMember(groupId)
          && (!('monthlyBudget' in request.resource.data)
              || (request.resource.data.monthlyBudget is int && request.resource.data.monthlyBudget >= 0));
      }
      match /expenses/{expenseId} {
        allow read: if isMember(groupId);
        allow delete: if isMember(groupId) && tripOpen(groupId);
        // Bind the author and require a non-negative numeric total on create/update.
        // A refund (kind 'refund') names its original and has no gift card or
        // discount; its amounts stay positive and the app counts them against
        // spending. A saved expense never switches between purchase and refund,
        // and a refund stays with the original it was made from.
        function isRefundDoc(data) { return data.get('kind', null) == 'refund'; }
        // Trips: an expense may name its currency (an ISO code) and how it was paid —
        // by card at "1 home = rate foreign", estimated until the amount charged
        // (homeTotal, home minor units) is entered, or from a cash wallet.
        function validCurrency(d) { return !('currency' in d) || (d.currency is string && d.currency.matches('[A-Z]{3}')); }
        function validCard(p) {
          return p.keys().hasOnly(['kind', 'rate', 'rateStatus', 'homeTotal'])
            && p.get('rate', 0) is number && p.get('rate', 0) > 0
            && p.get('rateStatus', null) in ['estimated', 'actual']
            && (!('homeTotal' in p) || (p.homeTotal is number && p.homeTotal >= 0));
        }
        function validPayment(d) {
          return !('paidWith' in d) || (d.paidWith is map && (
            (d.paidWith.get('kind', null) == 'card' && validCard(d.paidWith))
            || (d.paidWith.get('kind', null) == 'wallet' && d.paidWith.keys().hasOnly(['kind', 'walletId'])
                && d.paidWith.get('walletId', null) is string
                // Cash comes out of the kitty or the payer's own wallet, which must exist.
                && existsAfter(/databases/$(database)/documents/groups/$(groupId)/wallets/$(d.paidWith.walletId))
                && ((getAfter(/databases/$(database)/documents/groups/$(groupId)/wallets/$(d.paidWith.walletId)).data.kind == 'kitty'
                     // Whoever hands over the kitty's cash is on the trip.
                     && d.payerUid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids)
                    || getAfter(/databases/$(database)/documents/groups/$(groupId)/wallets/$(d.paidWith.walletId)).data.get('ownerUid', null) == d.payerUid))));
        }
        allow create, update: if isMember(groupId) && tripOpen(groupId)
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.total is number
          && request.resource.data.total >= 0
          && validCurrency(request.resource.data)
          && validPayment(request.resource.data)
          && (!('giftCardAmount' in request.resource.data)
              || (request.resource.data.giftCardAmount is number
                  && request.resource.data.giftCardAmount >= 0
                  && request.resource.data.giftCardAmount <= request.resource.data.total))
          && (('kind' in request.resource.data)
              ? (request.resource.data.kind == 'refund'
                 && request.resource.data.refundOf is string
                 && !('giftCardAmount' in request.resource.data)
                 && !('discountPercent' in request.resource.data))
              : !('refundOf' in request.resource.data))
          && (resource == null
              || (isRefundDoc(request.resource.data) == isRefundDoc(resource.data)
                  && request.resource.data.get('refundOf', null) == resource.data.get('refundOf', null)));
        match /items/{itemId} {
          allow read: if isMember(groupId);
          allow delete: if isMember(groupId) && tripOpen(groupId);
          // An item is a refund item exactly when its expense is a refund. getAfter
          // sees the expense when both are saved in one batch, as the app does.
          allow create, update: if isMember(groupId) && tripOpen(groupId)
            && request.resource.data.amount is number
            && request.resource.data.amount >= 0
            && (!('refund' in request.resource.data) || request.resource.data.refund is bool)
            // Tags: a list of at most 10 (the app also caps each at 40 characters).
            && (!('tags' in request.resource.data)
                || (request.resource.data.tags is list && request.resource.data.tags.size() <= 10))
            // Trips: who shares a shared item, one to twenty people.
            && (!('sharedWith' in request.resource.data)
                || (request.resource.data.sharedWith is list
                    && request.resource.data.sharedWith.size() >= 1
                    && request.resource.data.sharedWith.size() <= 20))
            && request.resource.data.get('refund', false)
               == isRefundDoc(getAfter(/databases/$(database)/documents/groups/$(groupId)/expenses/$(expenseId)).data);
        }
      }
      match /income/{incomeId} {
        allow read: if isMember(groupId);
        allow delete: if isMember(groupId) && resource.data.uid == request.auth.uid;
        allow create: if isMember(groupId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0;
        allow update: if isMember(groupId)
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0;
      }
      match /settlements/{settlementId} {
        allow read, delete: if isMember(groupId);
        allow create, update: if isMember(groupId)
          && (!('amount' in request.resource.data)
              || (request.resource.data.amount is number && request.resource.data.amount >= 0));
      }
      // Trips: cash wallets. A member's own, one per person per foreign currency
      // (id ownerUid_CUR, the owner on the trip, any member may keep it for them),
      // or the trip's shared kitty (id kitty_CUR, no owner). Kind, owner and
      // currency never change.
      match /wallets/{walletId} {
        allow read: if isMember(groupId);
        allow delete: if isMember(groupId) && tripOpen(groupId);
        allow create, update: if isMember(groupId) && tripOpen(groupId)
          && request.resource.data.currency is string
          && request.resource.data.currency.matches('[A-Z]{3}')
          && (request.resource.data.kind == 'kitty'
              ? (walletId == 'kitty_' + request.resource.data.currency
                 && !('ownerUid' in request.resource.data))
              : (request.resource.data.kind == 'personal'
                 && request.resource.data.ownerUid is string
                 && walletId == request.resource.data.ownerUid + '_' + request.resource.data.currency
                 && request.resource.data.ownerUid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids))
          // A kitty's leftover may be kept by one member instead of being handed back.
          && (!('keptBy' in request.resource.data)
              || (request.resource.data.kind == 'kitty'
                  && request.resource.data.keptBy in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids))
          && (resource == null
              || (request.resource.data.kind == resource.data.kind
                  && request.resource.data.get('ownerUid', null) == resource.data.get('ownerUid', null)
                  && request.resource.data.currency == resource.data.currency));
      }
      // Cash put into a wallet: whole minor units received (> 0) and paid (>= 0), on a day,
      // by the member writing it, into a wallet that exists once the write lands.
      match /topUps/{topUpId} {
        allow read: if isMember(groupId);
        allow delete: if isMember(groupId) && tripOpen(groupId);
        allow create, update: if isMember(groupId) && tripOpen(groupId)
          && request.resource.data.keys().hasOnly(['id', 'walletId', 'byUid', 'fromUid', 'date', 'foreignAmount', 'homeAmount', 'createdAt'])
          && request.resource.data.byUid == request.auth.uid
          && request.resource.data.walletId is string
          && existsAfter(/databases/$(database)/documents/groups/$(groupId)/wallets/$(request.resource.data.walletId))
          && request.resource.data.foreignAmount is int && request.resource.data.foreignAmount > 0
          && request.resource.data.homeAmount is int && request.resource.data.homeAmount >= 0
          && isIsoDate(request.resource.data.date)
          // Money in the kitty names who put it in, someone on the trip; a member's own cash is theirs.
          && (getAfter(/databases/$(database)/documents/groups/$(groupId)/wallets/$(request.resource.data.walletId)).data.kind == 'kitty'
              ? (request.resource.data.get('fromUid', null) is string
                 && request.resource.data.fromUid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids)
              : !('fromUid' in request.resource.data));
      }
      // Trips: foreign cash one member hands another to settle up, out of the giver's
      // own wallet in that currency into the receiver's (created in the same batch if new).
      match /handovers/{handoverId} {
        allow read: if isMember(groupId);
        allow delete: if isMember(groupId) && tripOpen(groupId);
        allow create, update: if isMember(groupId) && tripOpen(groupId)
          && request.resource.data.keys().hasOnly(['id', 'fromUid', 'toUid', 'currency', 'foreignAmount', 'date', 'byUid', 'createdAt'])
          && request.resource.data.byUid == request.auth.uid
          && request.resource.data.currency is string && request.resource.data.currency.matches('[A-Z]{3}')
          && request.resource.data.foreignAmount is int && request.resource.data.foreignAmount > 0
          && isIsoDate(request.resource.data.date)
          && request.resource.data.fromUid != request.resource.data.toUid
          && request.resource.data.fromUid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
          && request.resource.data.toUid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
          && exists(/databases/$(database)/documents/groups/$(groupId)/wallets/$(request.resource.data.fromUid + '_' + request.resource.data.currency))
          && existsAfter(/databases/$(database)/documents/groups/$(groupId)/wallets/$(request.resource.data.toUid + '_' + request.resource.data.currency));
      }
      match /suggestions/{doc} {
        allow read: if isMember(groupId);
        allow write: if isMember(groupId);
      }
    }

    match /{path=**}/items/{itemId} {
      allow read: if isMember(resource.data.groupId);
    }

    // Collection-group read for a user's own incoming invites. A dedicated
    // recursive-wildcard rule is required: the nested groups/{groupId}/invites
    // rule isn't reachable for a collection-group query (its isMember(groupId)
    // branch calls get() on the unbound groupId wildcard, which fails list auth).
    match /{path=**}/invites/{inviteId} {
      allow read: if emailVerified() && resource.data.email == myEmail();
    }
  }
}
