// Manual two-account verification checklist (run against emulator with two test users):
//   1. Member can read/write own group:
//      - Sign in as userA, create a group → expect success (201)
//      - Read that group as userA → expect success (200)
//      - Write an expense inside that group as userA → expect success
//   2. Non-member is denied read access to a group:
//      - Sign in as userB (not in the group's members array)
//      - Attempt to read that group document → expect PERMISSION_DENIED (403)
//      - Attempt to write an expense inside that group as userB → expect PERMISSION_DENIED

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function emailVerified() { return signedIn() && request.auth.token.email_verified == true; }
    // The accepting/invitee principal: signed-in, verified, and matching the invite email.
    function isInvitee() { return emailVerified() && resource != null && resource.data.email == myEmail(); }
    function isMember(groupId) {
      return signedIn()
        && (request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members);
    }
    function isOwner(groupId) {
      return signedIn()
        && get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.members
        && request.resource.data.memberUids.hasOnly([request.auth.uid]);
      // Members can only edit non-privileged fields
      allow update: if isMember(groupId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'currency'])
        // Owners can edit any group-level field (name, currency, ownerUid, members, memberUids)
        || ( isOwner(groupId)
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['name', 'currency', 'ownerUid', 'members', 'memberUids']) )
        // Invite acceptance: a verified user with a pending invite can add ONLY themselves
        // to members/memberUids. The join must be strictly additive (existing members/memberUids
        // preserved) AND the single added principal must be the accepting user.
        || ( signedIn()
             && request.auth.token.email_verified == true
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberUids'])
             && !(request.auth.uid in resource.data.members)
             && request.auth.uid in request.resource.data.members
             && get(/databases/$(database)/documents/groups/$(groupId)/invites/$(myEmail())).data.status == 'pending'
             // memberUids: strictly additive and the single new element is the caller
             && request.resource.data.memberUids.toSet().hasAll(resource.data.memberUids)
             && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
             && request.auth.uid in request.resource.data.memberUids
             && request.resource.data.memberUids.toSet()
                  .difference(resource.data.memberUids.toSet()) == [request.auth.uid].toSet()
             // members map: no existing key removed, and the only added key is the caller
             && resource.data.members.keys().toSet().difference(request.resource.data.members.keys().toSet()).size() == 0
             && request.resource.data.members.keys().toSet()
                  .difference(resource.data.members.keys().toSet()) == [request.auth.uid].toSet()
             // pin the new member's role to 'member'
             && request.resource.data.members[request.auth.uid].role == 'member' );
      allow delete: if isOwner(groupId);

      match /invites/{inviteId} {
        allow create: if isMember(groupId);
        // Members manage invites freely. An invitee (verified, email-matching) may
        // read their invite and transition it ONLY into a terminal state — never back
        // to 'pending' (which would defeat owner revocation; see M-1).
        allow read: if isMember(groupId) || isInvitee();
        allow update: if isMember(groupId)
          || (isInvitee() && request.resource.data.status != 'pending');
        allow delete: if isMember(groupId);
      }
      match /categories/{categoryId}    { allow read, write: if isMember(groupId); }
      match /expenses/{expenseId} {
        allow read, delete: if isMember(groupId);
        // Bind the author and require a non-negative numeric total on create/update.
        allow create, update: if isMember(groupId)
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.total is number
          && request.resource.data.total >= 0
          && (!('giftCardAmount' in request.resource.data)
              || (request.resource.data.giftCardAmount is number
                  && request.resource.data.giftCardAmount >= 0
                  && request.resource.data.giftCardAmount <= request.resource.data.total));
        match /items/{itemId} {
          allow read, delete: if isMember(groupId);
          allow create, update: if isMember(groupId)
            && request.resource.data.amount is number
            && request.resource.data.amount >= 0;
        }
      }
      match /income/{incomeId} {
        allow read: if isMember(groupId);
        allow delete: if isMember(groupId) && resource.data.uid == request.auth.uid;
        allow create: if isMember(groupId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0;
        allow update: if isMember(groupId)
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0;
      }
      match /settlements/{settlementId} {
        allow read, delete: if isMember(groupId);
        allow create, update: if isMember(groupId)
          && (!('amount' in request.resource.data)
              || (request.resource.data.amount is number && request.resource.data.amount >= 0));
      }
      match /suggestions/{doc} {
        allow read: if isMember(groupId);
        allow write: if isMember(groupId);
      }
    }

    match /{path=**}/items/{itemId} {
      allow read: if isMember(resource.data.groupId);
    }

    // Collection-group read for a user's own incoming invites. A dedicated
    // recursive-wildcard rule is required: the nested groups/{groupId}/invites
    // rule isn't reachable for a collection-group query (its isMember(groupId)
    // branch calls get() on the unbound groupId wildcard, which fails list auth).
    match /{path=**}/invites/{inviteId} {
      allow read: if emailVerified() && resource.data.email == myEmail();
    }
  }
}
